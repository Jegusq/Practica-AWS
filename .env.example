# Copia este fichero a .env SOLO para desarrollo local. Nunca subas credenciales al repo.
# Las credenciales de AWS NO van aqui: usa `aws login` / `aws sso login` o un perfil.

AWS_REGION=eu-west-3
# Perfil de AWS CLI a usar en local (opcional)
# AWS_PROFILE=default

# Bucket de S3 (lo crea Terraform; ver `terraform output`)
KID_BUCKET=
# Modelo de Bedrock (perfil de inferencia geografico UE)
BEDROCK_MODEL_ID=eu.anthropic.claude-haiku-5-5

# Base de datos (salidas de Terraform)
DB_CLUSTER_ARN=
DB_SECRET_ARN=
DB_NAME=kid

# Contacto que se incluye en el User-Agent del scraper (buena practica)
KID_CONTACT=tu-correo@ejemplo.com

# URL de la API (para la app Streamlit)
API_URL=
